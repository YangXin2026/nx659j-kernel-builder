# 4.19-kona-ksu-a16fix-oc · 配置分段（Phase 0 不合并）

# ===== Section A/B/C 说明（Phase 2/3）=====
# A16/GSI 兼容、FOD 节点、GPU OC 均属 Phase 2/3，默认不启用。

# ===== Section D: SukiSU Ultra（Phase 1，main + KPROBES）=====
CONFIG_KSU=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_KPROBES=y
CONFIG_KRETPROBES=y
CONFIG_EXT4_FS=y
CONFIG_KSU_SUSFS=n
# 首轮开日志便于排错，稳定后改回 n
CONFIG_KSU_DEBUG=y
# KPM 关闭（稳定性优先）
# CONFIG_KPM is not set