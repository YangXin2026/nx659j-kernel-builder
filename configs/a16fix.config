# 4.19-kona-ksu-a16fix-oc · 配置分段（Phase 0 不合并）

# ===== Section A/B/C 说明（Phase 2/3）=====
# A16/GSI 兼容、FOD 节点、GPU OC 均属 Phase 2/3，默认不启用。

# ===== Section D: SukiSU-Ultra v4.3.0（Phase 1，main + KPROBES 自动 hook）=====
# 4.19 上唯一坑是 MODULE_IMPORT_NS（5.10 才有的宏），由 scripts/apply-kernelsu.sh 兜底补丁处理
CONFIG_MODULES=y
CONFIG_MODULES_USE_ELF_RELA=y
CONFIG_KSU=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_KPROBES=y
CONFIG_KRETPROBES=y
CONFIG_EXT4_FS=y
CONFIG_KSU_SUSFS=n
# 2026-11-02：关掉 DEBUG。KSU_DEBUG 会打开大量 pr_alert 并强制 allow_shell=true，
# 是最容易把"能开机"变成"开不了机"的单项。其余 10 项保持与 #114 完全一致。
CONFIG_KSU_DEBUG=n
# KPM 关闭（稳定性优先）
# CONFIG_KPM is not set
CONFIG_COMPAT=y
CONFIG_COMPAT_VDSO=n
