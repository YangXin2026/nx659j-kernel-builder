# 4.19-kona-ksu-a16fix-oc · 配置分段（Phase 0 不合并）

# ===== Section A/B/C 说明（Phase 2/3）=====
# A16/GSI 兼容、FOD 节点、GPU OC 均属 Phase 2/3，默认不启用。

# ===== Section D: ReSukiSU v4.2.0-rc3（Phase 1，main + KPROBES 自动 hook）=====
# 注：SukiSU-Ultra v4.3.0 在 4.19 上编不过（MODULE_IMPORT_NS 无保护），改用 ReSukiSU
CONFIG_MODULES=y
CONFIG_MODULES_USE_ELF_RELA=y
CONFIG_KSU=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_KPROBES=y
CONFIG_KRETPROBES=y
CONFIG_EXT4_FS=y
CONFIG_KSU_SUSFS=n
CONFIG_KSU_DEBUG=y
# KPM 关闭（稳定性优先）
# CONFIG_KPM is not set
CONFIG_COMPAT=y
CONFIG_COMPAT_VDSO=n
