# 完整 LOS 配置：只关 qcacld（缺 ce_api.h），其余交给 kona-perf + nx659j
CONFIG_MODULES=y
# CONFIG_QCA_CLD_WLAN is not set
# CONFIG_QCACLD is not set

# 内核版本名控制
# 关掉自动附加 SCM 版本：否则 scripts/setlocalversion 会追加 "-g<hash>-dirty"，
# 叠加本内核自带前缀 "4.19.325-cip135-st19-perf-"（26 字符）后会超出内核
# 硬限制的 64 字符，直接编译失败（include/generated/utsrelease.h Error 1）。
# 关掉后版本名形如：
#   4.19.325-cip135-st19-perf-A16FIX-KSU-OC-20251101-1430
# CONFIG_LOCALVERSION_AUTO is not set