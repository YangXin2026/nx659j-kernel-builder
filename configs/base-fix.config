# 完整 LOS 配置，其余交给 kona-perf + nx659j
#
# 2026-11-02 改动（分支 qcacld-wifi，已在 CI run #116 验证可编译）：
#   打开 qcacld。原注释称"缺 ce_api.h"，已核实该文件存在于
#   drivers/staging/qca-wifi-host-cmn/hif/src/ce/ce_api.h（HTTP 200），注释过期。
#   WiFi 走内核内建，不再依赖 vendor 的 wlan.ko（那颗是给原厂 4.19.113 编的，
#   MODVERSIONS 导致符号 CRC 与本内核不匹配，必然 insmod 失败）。
CONFIG_MODULES=y
CONFIG_QCA_CLD_WLAN=y
CONFIG_QCA_CLD_WLAN_PROFILE="qca6390"

# 内核版本名控制
# 关掉自动附加 SCM 版本：否则 scripts/setlocalversion 会追加 "-g<hash>-dirty"，
# 叠加本内核自带前缀 "4.19.325-cip135-st19-perf-"（26 字符）后会超出内核
# 硬限制的 64 字符，直接编译失败（include/generated/utsrelease.h Error 1）。
# CONFIG_LOCALVERSION_AUTO is not set
