# 基础修复片段：所有构建都合并
# 4.19 MHI 驱动依赖 IPC_LOGGING/MSM_PCIE，基线配置未带，先关闭
# CONFIG_MHI_BUS is not set
# CONFIG_MHI_BUS_PCI_GENERIC is not set

# nx659j 配置会带 qcacld，但缺 ce_api.h 等依赖；先关掉 WLAN 驱动
# CONFIG_QCA_CLD_WLAN is not set
# CONFIG_QCACLD is not set
# CONFIG_WLAN is not set

# 不启用模块，避免内置驱动引用模块符号导致 Image 链接失败
# CONFIG_MODULES is not set
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_MSM_BT_POWER=y
CONFIG_BTFM_SLIM=y
CONFIG_QCOM_ICE=y
CONFIG_DRM_MSM=y