# Phase 1 minimal: KSU only, no nx659j device config, no COMPAT/32-bit vdso
CONFIG_MODULES=y
CONFIG_MODULES_USE_ELF_RELA=y
CONFIG_KSU=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_KPROBES=y
CONFIG_KRETPROBES=y
CONFIG_EXT4_FS=y
CONFIG_KSU_SUSFS=n
CONFIG_KSU_DEBUG=y
# CONFIG_KPM is not set
# CONFIG_MHI_BUS is not set
# CONFIG_MHI_BUS_PCI_GENERIC is not set
CONFIG_COMPAT=y
CONFIG_KSU_DISABLE_POLICY=y
CONFIG_KSU_DISABLE_MANAGER=y
# CONFIG_KSU_MANUAL_SU is not set
